<launch>
  <!--
    Personal RTAB-Map mapping launch for the WHEELTEC robot.
    Copy to: /home/wheeltec/fahad/launch/fahad_3d_mapping.launch

    Existing databases are never deleted by this file. To make a new map,
    supply a new database_path rather than overwriting an old one.
  -->
  <arg name="database_path" default="$(env HOME)/fahad/maps/lab_room.db" />

  <!-- Start the vendor's normal 2D mapping/base/LiDAR stack. -->
  <include file="$(find turn_on_wheeltec_robot)/launch/mapping.launch">
    <arg name="mapping_mode" value="gmapping" />
    <arg name="navigation" value="false" />
    <arg name="odom_frame_id" value="odom" />
  </include>

  <!-- Start the Astra camera. -->
  <include file="$(find turn_on_wheeltec_robot)/launch/wheeltec_camera.launch" />

  <!-- Synchronize colour and depth for RTAB-Map. -->
  <group ns="rtabmap">
    <node pkg="nodelet" type="nodelet" name="rgbd_sync"
          args="standalone rtabmap_ros/rgbd_sync" output="screen">
      <remap from="rgb/image" to="/camera/rgb/image_raw" />
      <remap from="depth/image" to="/camera/depth/image" />
      <remap from="rgb/camera_info" to="/camera/rgb/camera_info" />
      <remap from="rgbd_image" to="rgbd_image" />
      <param name="approx_sync" value="true" />
    </node>

    <!-- Existing database deletion is intentionally disabled. -->
    <node name="rtabmap" pkg="rtabmap_ros" type="rtabmap" output="screen">
      <param name="frame_id" type="string" value="base_footprint" />
      <param name="database_path" type="string" value="$(arg database_path)" />
      <param name="subscribe_depth" type="bool" value="false" />
      <param name="subscribe_rgb" type="bool" value="false" />
      <param name="subscribe_rgbd" type="bool" value="true" />
      <param name="subscribe_scan" type="bool" value="true" />

      <remap from="odom" to="/odom" />
      <remap from="scan" to="/scan" />
      <remap from="rgbd_image" to="rgbd_image" />

      <param name="queue_size" type="int" value="10" />
      <param name="RGBD/NeighborLinkRefining" type="string" value="true" />
      <param name="RGBD/ProximityBySpace" type="string" value="true" />
      <param name="RGBD/AngularUpdate" type="string" value="0.01" />
      <param name="RGBD/LinearUpdate" type="string" value="0.01" />
      <param name="RGBD/OptimizeFromGraphEnd" type="string" value="false" />
      <param name="Grid/FromDepth" type="string" value="false" />
      <param name="Reg/Force3DoF" type="string" value="true" />
      <param name="Reg/Strategy" type="string" value="1" />
      <param name="Icp/VoxelSize" type="string" value="0.05" />
      <param name="Icp/MaxCorrespondenceDistance" type="string" value="0.1" />
    </node>
  </group>
</launch>
